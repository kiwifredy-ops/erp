DATABASE_URL="mysql://user:password@localhost:3306/erp_seguridad"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5174"

# --- Plataforma multi-cliente -----------------------------------------------
# Base de control (registro de empresas), separada de la base de cada empresa.
DATABASE_URL_PLATAFORMA="mysql://user:password@localhost:3306/erp_plataforma"
# Host/puerto/credenciales sin el nombre de base — se combina en tiempo de
# ejecución con el dbName de cada empresa para conectarse a su base.
TENANT_DB_BASE_URL="mysql://user:password@localhost:3306"
JWT_SECRET_PLATAFORMA="change-me-to-a-different-long-random-string"
# Usados solo la primera vez que se corre npm run db:bootstrap:plataforma.
SUPERADMIN_EMAIL="admin@plataforma.local"
SUPERADMIN_PASSWORD="change-me"
EMPRESA_INICIAL_NOMBRE="Empresa Principal"
EMPRESA_INICIAL_SLUG="principal"
