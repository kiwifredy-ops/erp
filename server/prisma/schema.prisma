generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- Auth / Usuarios del sistema ---------------------------------------

model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String
  rol       String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// --- RRHH ----------------------------------------------------------------

model Empleado {
  id           String             @id @default(cuid())
  nombre       String
  documento    String             @unique
  cargo        String
  departamento String
  tipoContrato String
  fechaIngreso DateTime
  estado       String             @default("Activo")
  email        String?
  telefono     String?
  createdAt    DateTime           @default(now())

  // Contrato
  fechaTerminoContrato DateTime? // plazo fijo / fecha determinada — alerta 5 días antes

  // Previsión
  afp             String?
  isapre          String?
  isapreAdicional String?

  // Datos personales
  estadoCivil               String?
  direccionCalle            String?
  direccionNumero           String?
  direccionComuna           String?
  direccionCiudad           String?
  contactoEmergenciaNombre  String?
  contactoEmergenciaTelefono String?

  // Salud
  grupoSanguineo     String?
  alergias           String? @db.Text
  tratamientoMedico  String? @db.Text

  // Licencia de conducir
  licenciaConducir Boolean @default(false)
  licenciaClase    String?

  // Cédula de identidad — alerta 1 mes antes del vencimiento
  rutSerie       String?
  rutVencimiento DateTime?

  bitacora   EmpleadoBitacora[]
  hijos      Hijo[]
  documentos Documento[]
}

model Hijo {
  id              String    @id @default(cuid())
  empleadoId      String
  empleado        Empleado  @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  nombre          String
  fechaNacimiento DateTime?

  @@index([empleadoId])
}

// Almacena contratos, anexos, foto de perfil, cédula (frente/dorso) y
// licencia de conducir (frente/dorso) como base64 — sin infraestructura de
// almacenamiento de archivos adicional.
model Documento {
  id            String   @id @default(cuid())
  empleadoId    String
  empleado      Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  tipo          String
  nombreArchivo String
  mimeType      String
  contenido     String   @db.LongText
  fechaSubida   DateTime @default(now())

  @@index([empleadoId])
}

model EmpleadoBitacora {
  id         String   @id @default(cuid())
  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  fecha      DateTime
  evento     String
  detalle    String?  @db.Text

  @@index([empleadoId])
}

// --- Almacén y Logística --------------------------------------------------

model Item {
  id          String           @id @default(cuid())
  nombre      String
  categoria   String
  unidad      String
  stock       Int              @default(0)
  stockMinimo Int              @default(0)
  ubicacion   String
  createdAt   DateTime         @default(now())
  movimientos ItemMovimiento[]
}

model ItemMovimiento {
  id       String   @id @default(cuid())
  itemId   String
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fecha    DateTime
  tipo     String
  cantidad Int
  motivo   String?  @db.Text

  @@index([itemId])
}

model Equipo {
  id              String           @id @default(cuid())
  equipo          String
  tipo            String
  tecnico         String?
  estado          String           @default("En bodega")
  fechaAsignacion DateTime?
  createdAt       DateTime         @default(now())

  numeroSerie        String?
  fechaCompra         DateTime?
  mesesGarantia       Int?
  clienteInstalacion  String?

  bitacora        EquipoBitacora[]
}

model EquipoBitacora {
  id       String   @id @default(cuid())
  equipoId String
  equipo   Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  fecha    DateTime
  evento   String
  detalle  String?  @db.Text

  @@index([equipoId])
}

// --- Rendición de Gastos --------------------------------------------------

model Rendicion {
  id        String              @id @default(cuid())
  folio     String              @unique
  tecnico   String
  fecha     DateTime
  estado    String              @default("Enviada")
  createdAt DateTime            @default(now())
  lineas    RendicionLinea[]
  bitacora  RendicionBitacora[]
}

model RendicionLinea {
  id          String    @id @default(cuid())
  rendicionId String
  rendicion   Rendicion @relation(fields: [rendicionId], references: [id], onDelete: Cascade)
  categoria   String
  monto       Int
  descripcion String
  fecha       DateTime

  // Kilometraje: km recorridos con vehículo propio (monto se calcula × tarifa/km)
  kilometros Int?

  // Boleta/factura adjunta, como base64 (mismo enfoque que Documento en RRHH)
  comprobante       String? @db.LongText
  comprobanteNombre String?

  // Datos tributarios (Chile) — null = sin documento tributario asociado
  // (compatible con líneas creadas antes de este campo). montoNeto/iva se
  // calculan en el backend a partir de monto + tipoDocumento, nunca se
  // confía en lo que mande el cliente.
  tipoDocumento  String? // Boleta electrónica | Factura electrónica | Factura exenta | Boleta exenta | Factura de compra | Boleta de honorarios | Guía de despacho | Sin documento
  rutProveedor   String?
  montoNeto      Int?
  iva            Int?
  ivaRecuperable Boolean @default(false)

  @@index([rendicionId])
}

model RendicionBitacora {
  id          String    @id @default(cuid())
  rendicionId String
  rendicion   Rendicion @relation(fields: [rendicionId], references: [id], onDelete: Cascade)
  fecha       DateTime
  evento      String
  detalle     String?   @db.Text

  @@index([rendicionId])
}

// --- Asistencia ------------------------------------------------------------

model Marcacion {
  id              String   @id @default(cuid())
  empleado        String
  fecha           DateTime
  horaEntrada     String?
  horaSalida      String?
  estado          String
  horasTrabajadas Float    @default(0)
  horasExtra      Float    @default(0)
  createdAt       DateTime @default(now())

  // Geolocalización de la marcación (estilo GeoVictoria) — coordenadas al
  // marcar entrada y, por separado, al marcar salida.
  latEntrada    Float?
  lngEntrada    Float?
  latSalida     Float?
  lngSalida     Float?
}

// --- Flota de Vehículos -----------------------------------------------------

model Vehiculo {
  id                  String             @id @default(cuid())
  patente             String             @unique
  marca               String
  modelo              String
  anio                Int
  tipo                String
  estado              String             @default("Disponible")
  tecnico             String?
  kilometraje         Int                @default(0)
  proximaMantencionKm Int                @default(0)
  createdAt           DateTime           @default(now())

  // Documentación legal del vehículo — cada una con vencimiento propio.
  vencimientoRevisionTecnica    DateTime?
  vencimientoSeguro             DateTime?
  vencimientoPermisoCirculacion DateTime?

  bitacora            VehiculoBitacora[]
}

model VehiculoBitacora {
  id         String   @id @default(cuid())
  vehiculoId String
  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  fecha      DateTime
  evento     String
  detalle    String?  @db.Text

  @@index([vehiculoId])
}

// --- Abastecimiento ----------------------------------------------------------

model Proveedor {
  id       String  @id @default(cuid())
  nombre   String
  rubro    String
  contacto String?
  telefono String?
  activo   Boolean @default(true)
}

model OrdenCompra {
  id        String                @id @default(cuid())
  folio     String                @unique
  proveedor String
  fecha     DateTime
  estado    String                @default("Solicitada")
  createdAt DateTime              @default(now())

  fechaEntregaEstimada DateTime?
  calificacionProveedor Int? // 1-5, registrada al marcar la orden como Recibida

  // Factura o guía de despacho adjunta, como base64.
  documentoNombre    String?
  documentoMimeType  String?
  documentoContenido String?  @db.LongText

  items     OrdenCompraItem[]
  bitacora  OrdenCompraBitacora[]
}

model OrdenCompraItem {
  id             String      @id @default(cuid())
  ordenId        String
  orden          OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  descripcion    String
  cantidad       Int
  precioUnitario Int

  @@index([ordenId])
}

model OrdenCompraBitacora {
  id      String      @id @default(cuid())
  ordenId String
  orden   OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  fecha   DateTime
  evento  String
  detalle String?     @db.Text

  @@index([ordenId])
}

// --- Contabilidad --------------------------------------------------------

model CuentaBancaria {
  id           String   @id @default(cuid())
  nombre       String
  banco        String
  numeroCuenta String
  tipo         String   @default("Cuenta Corriente")
  saldoInicial Int      @default(0)
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now())

  movimientos MovimientoBancario[]
}

model MovimientoBancario {
  id          String         @id @default(cuid())
  cuentaId    String
  cuenta      CuentaBancaria @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  fecha       DateTime
  tipo        String // Ingreso | Egreso
  categoria   String // Pago de cliente, Pago a proveedor, Gasto operacional, Transferencia, Otro
  descripcion String
  monto       Int
  createdAt   DateTime       @default(now())

  @@index([cuentaId])
}

model FacturaVenta {
  id               String   @id @default(cuid())
  folio            String   @unique
  cliente          String
  clienteId        String?
  clienteRef       Cliente? @relation(fields: [clienteId], references: [id])
  fechaEmision     DateTime
  fechaVencimiento DateTime
  montoNeto        Int
  iva              Int
  montoTotal       Int
  montoPagado      Int      @default(0)
  estado           String   @default("Pendiente") // Pendiente | Pagada | Anulada
  createdAt        DateTime @default(now())

  pagos        PagoCliente[]
  notasCredito NotaCreditoVenta[]
  bitacora     FacturaVentaBitacora[]

  @@index([clienteId])
}

model PagoCliente {
  id        String       @id @default(cuid())
  facturaId String
  factura   FacturaVenta @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  fecha     DateTime
  monto     Int
  medioPago String
  cuentaId  String?
  createdAt DateTime     @default(now())

  @@index([facturaId])
}

model NotaCreditoVenta {
  id        String       @id @default(cuid())
  folio     String       @unique
  facturaId String
  factura   FacturaVenta @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  fecha     DateTime
  motivo    String
  monto     Int
  createdAt DateTime     @default(now())

  @@index([facturaId])
}

model FacturaVentaBitacora {
  id        String       @id @default(cuid())
  facturaId String
  factura   FacturaVenta @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  fecha     DateTime
  evento    String
  detalle   String?      @db.Text

  @@index([facturaId])
}

model FacturaCompra {
  id               String   @id @default(cuid())
  folio            String   @unique
  proveedor        String
  fechaEmision     DateTime
  fechaVencimiento DateTime
  montoNeto        Int
  iva              Int
  montoTotal       Int
  montoPagado      Int      @default(0)
  estado           String   @default("Pendiente")
  createdAt        DateTime @default(now())

  pagos        PagoProveedor[]
  notasCredito NotaCreditoCompra[]
  bitacora     FacturaCompraBitacora[]
}

model PagoProveedor {
  id        String        @id @default(cuid())
  facturaId String
  factura   FacturaCompra @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  fecha     DateTime
  monto     Int
  medioPago String
  cuentaId  String?
  createdAt DateTime      @default(now())

  @@index([facturaId])
}

model NotaCreditoCompra {
  id        String        @id @default(cuid())
  folio     String        @unique
  facturaId String
  factura   FacturaCompra @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  fecha     DateTime
  motivo    String
  monto     Int
  createdAt DateTime      @default(now())

  @@index([facturaId])
}

model FacturaCompraBitacora {
  id        String        @id @default(cuid())
  facturaId String
  factura   FacturaCompra @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  fecha     DateTime
  evento    String
  detalle   String?       @db.Text

  @@index([facturaId])
}

// --- Tickets de Servicio Técnico ------------------------------------------
//
// Mesa de ayuda crea y asigna el ticket a un técnico. El técnico, desde una
// tablet en terreno, inicia el servicio (queda registrada su ubicación GPS),
// adjunta fotos/video, escribe observaciones y finaliza (segunda ubicación
// GPS). Al cierre, el cliente firma en pantalla y responde una encuesta de
// satisfacción breve.

model Ticket {
  id          String   @id @default(cuid())
  folio       String   @unique
  cliente     String
  clienteId   String?
  clienteRef  Cliente? @relation(fields: [clienteId], references: [id])
  direccion   String
  descripcion String   @db.Text
  prioridad   String   @default("Media") // Baja | Media | Alta | Urgente
  tecnico     String?
  estado      String   @default("Abierto") // Abierto | Asignado | En curso | Completado | Cerrado | Cancelado
  createdAt   DateTime @default(now())

  fechaInicio DateTime?
  latInicio   Float?
  lngInicio   Float?

  fechaFin       DateTime?
  latFin         Float?
  lngFin         Float?
  observaciones  String?   @db.Text

  firmaCliente String? @db.LongText // PNG capturado en un canvas, como base64

  bitacora TicketBitacora[]
  archivos TicketArchivo[]
  encuesta EncuestaSatisfaccion?

  @@index([clienteId])
}

model TicketBitacora {
  id       String   @id @default(cuid())
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fecha    DateTime
  evento   String
  detalle  String?  @db.Text

  @@index([ticketId])
}

model TicketArchivo {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tipo          String // Foto | Video
  nombreArchivo String
  mimeType      String
  contenido     String   @db.LongText
  fechaSubida   DateTime @default(now())

  @@index([ticketId])
}

model EncuestaSatisfaccion {
  id           String   @id @default(cuid())
  ticketId     String   @unique
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  calificacion Int // 1-5
  comentario   String?  @db.Text
  fecha        DateTime @default(now())
}

// --- Clientes --------------------------------------------------------------
//
// Base de clientes de la empresa. Se puede vincular opcionalmente desde
// Tickets y Facturas de Venta (clienteId) — el nombre en texto libre de esos
// registros se mantiene igual como respaldo/histórico, así que no es
// obligatorio tener al cliente registrado aquí para operar en esos módulos.

model Cliente {
  id              String   @id @default(cuid())
  tipo            String   @default("Empresa") // Empresa | Persona
  nombre          String
  rut             String?  @unique
  direccion       String?
  comuna          String?
  ciudad          String?
  telefono        String?
  email           String?
  contactoNombre  String?
  contactoCargo   String?
  contactoTelefono String?
  notas           String?  @db.Text
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())

  tickets             Ticket[]
  facturasVenta       FacturaVenta[]
  contratosMantencion ContratoMantencion[]
  visitasMantencion   VisitaMantencion[]
}

// --- Mantenimiento -----------------------------------------------------
//
// Control de servicios de mantención de sistemas de seguridad en los
// clientes, tanto bajo contrato (con periodicidad y vigencia) como
// puntuales/no contratados. Un ContratoMantencion agrupa la periodicidad y
// la vigencia; cada VisitaMantencion es una fecha concreta de la agenda —
// generada a partir de un contrato o creada suelta para un servicio
// puntual sin contrato.

model ContratoMantencion {
  id                String   @id @default(cuid())
  folio             String   @unique
  clienteId         String?
  clienteRef        Cliente? @relation(fields: [clienteId], references: [id])
  cliente           String
  tipoMantenimiento String // Cámaras y CCTV | Alarmas | Control de Acceso | Cercos eléctricos | Integral | Otro
  periodicidad      String // Mensual | Bimestral | Trimestral | Semestral | Anual
  fechaInicio       DateTime
  fechaTermino      DateTime
  estado            String   @default("Activo") // Activo | Cancelado — "vencido" se calcula desde fechaTermino, no se almacena
  valorMensual      Int?
  alcance           String?  @db.Text
  createdAt         DateTime @default(now())

  visitas  VisitaMantencion[]
  bitacora ContratoMantencionBitacora[]

  @@index([clienteId])
}

model ContratoMantencionBitacora {
  id         String             @id @default(cuid())
  contratoId String
  contrato   ContratoMantencion @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  fecha      DateTime
  evento     String
  detalle    String?            @db.Text

  @@index([contratoId])
}

model VisitaMantencion {
  id                String              @id @default(cuid())
  folio             String              @unique
  contratoId        String?
  contrato          ContratoMantencion? @relation(fields: [contratoId], references: [id])
  clienteId         String?
  clienteRef        Cliente?            @relation(fields: [clienteId], references: [id])
  cliente           String
  direccion         String
  tipoMantenimiento String
  tecnico           String?
  fechaProgramada   DateTime
  fechaRealizada    DateTime?
  estado            String              @default("Programada") // Programada | En curso | Realizada | Cancelada
  observaciones     String?             @db.Text
  createdAt         DateTime            @default(now())

  bitacora VisitaMantencionBitacora[]

  @@index([contratoId])
  @@index([clienteId])
}

model VisitaMantencionBitacora {
  id       String           @id @default(cuid())
  visitaId String
  visita   VisitaMantencion @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  fecha    DateTime
  evento   String
  detalle  String?          @db.Text

  @@index([visitaId])
}

// --- Usuarios y Permisos ----------------------------------------------------
//
// El acceso se controla por rol (Usuario.rol), no por usuario individual.
// Cada combinación (rol, módulo) tiene 4 flags independientes: ver, crear,
// editar, eliminar. El backend aplica esto en cada endpoint de cada módulo;
// sin una fila de permiso explícita para (rol, módulo), el acceso se niega
// por defecto.

model RolPermiso {
  id            String  @id @default(cuid())
  rol           String
  moduloId      String
  puedeVer      Boolean @default(false)
  puedeCrear    Boolean @default(false)
  puedeEditar   Boolean @default(false)
  puedeEliminar Boolean @default(false)

  @@unique([rol, moduloId])
}

// --- Prevención de Riesgos --------------------------------------------------
//
// El vínculo a un trabajador es por nombre (String), no FK — mismo enfoque
// que Rendicion.tecnico y Marcacion.empleado, para no acoplar este módulo a
// que el trabajador siga existiendo en RRHH con el mismo id.

// Documentos legales a nivel empresa: Reglamento Interno de Higiene y
// Seguridad, Matriz IPER, Programa de Prevención anual, Certificado de la
// Mutualidad, Acta del Comité Paritario, etc.
model DocumentoPrevencion {
  id               String    @id @default(cuid())
  tipo             String
  nombre           String
  nombreArchivo    String
  mimeType         String
  contenido        String    @db.LongText
  fechaEmision     DateTime
  fechaVencimiento DateTime?
  notas            String?   @db.Text
  createdAt        DateTime  @default(now())
}

// Documentos de seguridad por trabajador: Obligación de Informar (ODI),
// entrega de EPP, exámenes ocupacionales, capacitaciones.
model DocumentoSeguridadEmpleado {
  id               String    @id @default(cuid())
  empleado         String
  tipo             String
  nombreArchivo    String
  mimeType         String
  contenido        String    @db.LongText
  fecha            DateTime
  fechaVencimiento DateTime?
  notas            String?   @db.Text
  createdAt        DateTime  @default(now())
}

model AccidenteIncidente {
  id               String   @id @default(cuid())
  folio            String   @unique
  empleado         String?
  fecha            DateTime
  tipo             String // Accidente del Trabajo | Accidente de Trayecto | Incidente sin lesión | Enfermedad Profesional
  gravedad         String // Leve | Grave | Fatal
  lugar            String?
  descripcion      String   @db.Text
  estado           String   @default("En investigación") // En investigación | Cerrado
  informeNombre    String?
  informeMimeType  String?
  informeContenido String?  @db.LongText
  createdAt        DateTime @default(now())

  bitacora AccidenteBitacora[]
}

model AccidenteBitacora {
  id          String             @id @default(cuid())
  accidenteId String
  accidente   AccidenteIncidente @relation(fields: [accidenteId], references: [id], onDelete: Cascade)
  fecha       DateTime
  evento      String
  detalle     String?            @db.Text

  @@index([accidenteId])
}
