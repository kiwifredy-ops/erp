{
  "name": "erp-seguridad-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:generate:plataforma": "prisma generate --schema=prisma/plataforma/schema.prisma",
    "db:push:plataforma": "prisma db push --schema=prisma/plataforma/schema.prisma",
    "db:push:tenants": "node prisma/pushTenantSchema.js",
    "db:bootstrap:plataforma": "node prisma/plataforma/bootstrap.js",
    "db:generate:all": "npm run db:generate && npm run db:generate:plataforma",
    "db:push:all": "npm run db:push && npm run db:push:plataforma && npm run db:push:tenants",
    "postinstall": "npm run db:generate:all"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
